# AWS SES Configuration for contact form emails
# All fields are required for email sending to work in production.
# Without these, the form will log submissions to the console (dev mode).

AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your_access_key_id
AWS_SECRET_ACCESS_KEY=your_secret_access_key

# The verified sender address in SES (must be verified in AWS SES console)
SES_FROM_EMAIL=no-reply@korbinian-schmidtner.com

# Where to send contact form submissions (defaults to SES_FROM_EMAIL if not set)
SES_TO_EMAIL=info@korbinian-schmidtner.com
