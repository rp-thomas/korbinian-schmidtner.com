---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import portraitImg from '../assets/pics/korbinian-portrait-patagonien.jpg';
import ivbvLogoImg from '../assets/pics/logos/ivbv-E-Mail.jpg';
import voebsLogoImg from '../assets/pics/logos/IVBV_Logo_National_Neu_1c.jpg'

const credentials = [
  {
    label: 'Staatlich geprüfter Berg- und Skiführer',
    sub: [],
  },
  {
    label: 'IFMGA Mitglied',
    sub: [
      {
        text: 'International Federation of Mountain Guides Associations',
        href: 'https://ifmga.net/',
      },
      {
        text: 'Verband der Österreichischen Berg- und Skiführer',
        href: 'https://www.bergfuehrer.at/',
      },
    ],
  },
  {
    label: '20+ Jahre alpine Erfahrung',
    sub: [
      { text: 'Sommer & Winter · Alle Disziplinen' },
    ],
  },
  {
    label: 'Individuelle Tourenplanung',
    sub: [
      { text: 'Einsteiger bis Fortgeschrittene' },
    ],
  },
];
---

<Layout title="Über mich" description="Korbinian Schmidtner – Staatlich geprüfter Berg- und Skiführer mit langjähriger alpiner Erfahrung.">

  <!-- Hero -->
  <div class="relative h-[70vh] min-h-[450px] overflow-hidden">
    <Image src={portraitImg} alt="Korbinian Schmidtner – Bergführer" class="w-full h-full object-cover object-[center_top]" loading="eager" widths={[800,1200,1920]} sizes="100vw" />
    <div class="absolute inset-0 flex items-end pb-16" style="background: var(--hero-overlay);">
      <div class="max-w-[1320px] mx-auto w-full px-6">
        <a href="/" class="block text-[0.75rem] font-semibold uppercase tracking-[0.1em] text-white/55 mb-5 no-underline hover:text-white/90 transition-colors">← Start</a>
        <span class="block text-[0.65rem] font-bold uppercase tracking-[0.2em] text-white/60 border border-white/20 px-3 py-1 w-fit mb-4">Staatlich geprüfter Berg- und Skiführer · IFMGA</span>
        <h1 class="text-[clamp(3.5rem,8vw,7rem)] font-extrabold text-white tracking-[-0.04em] leading-[0.9]">Über mich</h1>
      </div>
    </div>
  </div>

  <!-- Body -->
  <div class="max-w-[1320px] mx-auto px-6 py-16 pb-24">
    <div class="grid grid-cols-1 lg:grid-cols-[1fr_340px] gap-20 items-start">

      <!-- Text -->
      <div class="flex flex-col gap-5">
        <p class="text-[1.15rem] font-medium text-stone leading-[1.7]">
          Die Berge sind seit vielen Jahren meine Leidenschaft und mein berufliches Zuhause. Als staatlich geprüfter Berg- und Skiführer begleite ich Menschen sicher durch die faszinierende Welt des Alpinismus.
        </p>
        <p class="text-[0.975rem] text-stone-mid leading-[1.8]">
          Dank langjähriger Erfahrung in sämtlichen alpinen Disziplinen biete ich Touren und Kurse für Einsteiger, Fortgeschrittene und ambitionierte Alpinisten an. Mein Schwerpunkt liegt dabei auf Eisklettern, Skitouren, Hochtouren und Felsklettern.
        </p>
        <p class="text-[0.975rem] text-stone-mid leading-[1.8]">
          Sicherheit, professionelle Planung und individuelle Betreuung stehen bei jeder Unternehmung an erster Stelle. Mein Ziel ist es, unvergessliche Bergerlebnisse zu schaffen und gleichzeitig Wissen, Technik und Freude am Bergsport weiterzugeben.
        </p>
		
		<!-- Image -->
		<div class="flex justify-center items-center gap-20">
		  <Image
			  src={ivbvLogoImg}
			  alt="Bergführer"
			  width={125}
			/>
		  <Image
			  src={voebsLogoImg}
			  alt="Second Logo"
			  width={150}
		    />
		</div>
		
        <a href="/kontakt" class="self-start mt-2 inline-flex items-center gap-2 bg-accent text-white px-8 py-3.5 text-sm font-bold uppercase tracking-[0.08em] no-underline rounded-sm transition-[background,transform] duration-200 hover:bg-accent-hover hover:-translate-y-0.5">
          Tour anfragen
        </a>
           </div>

      <!-- Credentials -->
      <div class="flex flex-col lg:sticky lg:top-20">
        <span class="text-[0.7rem] font-bold uppercase tracking-[0.18em] text-accent mb-4">
          Qualifikationen
        </span>

        {credentials.map(c => (
          <div class="flex flex-col gap-1 py-5 border-b border-border first:border-t">
            <span class="text-[0.875rem] font-bold text-stone uppercase tracking-[0.04em]">
              {c.label}
            </span>

            {c.sub.map(item => (
              <span class="text-[0.75rem] text-stone-muted">
                {item.href ? (
                  <a
                    href={item.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="hover:text-accent underline"
                  >
                    {item.text}
                  </a>
                ) : (
                  item.text
                )}
              </span>
            ))}
          </div>
        ))}
      </div>

    </div>
  </div>

</Layout>
